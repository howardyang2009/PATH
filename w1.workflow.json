{
  "format": "path/workflow@3",
  "id": "7eae7dae-ee36-4d05-80b0-8fc895783d69",
  "name": "w1",
  "body": [
    {
      "id": "a728c16b-baef-40f2-9f11-2b88ac95e63e",
      "name": "gather-changes",
      "type": "binary",
      "command": "git",
      "args": [
        "log,",
        "--stat",
        "--no-color",
        "${config.commit_range}"
      ],
      "cwd": "${config.repo_path}",
      "publish": {
        "raw_changes": "${output}"
      }
    },
    {
      "id": "4bef80da-5092-4c9d-a84d-dbf04d84053e",
      "name": "have-changes",
      "type": "checkpoint",
      "condition": {
        "type": "matches",
        "path": "context.raw_changes",
        "pattern": "\\\\S"
      }
    }
  ]
}
