{
  "format": "path/workflow@4",
  "id": "3da8534b-f9a8-4b14-a270-e43f8b650571",
  "name": "draft-review",
  "input": {
    "topic": "the change you want written up"
  },
  "body": [
    {
      "type": "prompt",
      "id": "d5a5a47b-aba3-465c-bc5c-8583ec46d07c",
      "name": "draft",
      "input": {
        "topic": "${context.topic}"
      },
      "prompt": "Write a short draft about the topic in your input. Output markdown only.",
      "publish": {
        "draft": "${output}"
      }
    },
    {
      "type": "person-activity",
      "id": "dc7d59b6-dcee-436b-a80c-cb3622c6ce04",
      "name": "review",
      "description": "Read the draft. Answer \"approve\" to accept it, or anything else to reject it.",
      "input": {
        "draft": "${context.draft}"
      },
      "publish": {
        "review": "${output}"
      }
    }
  ],
  "output": {
    "draft": "${context.draft}",
    "review": "${context.review}"
  }
}
