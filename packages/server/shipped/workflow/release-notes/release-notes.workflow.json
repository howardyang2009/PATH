{
  "format": "path/workflow@6",
  "id": "a9ddf94b-5bbf-4796-894a-95804b05fc02",
  "name": "release-notes",
  "config": {
    "repo_url": "https://github.com/howardyang2009/PATH.git",
    "repo_path": "/tmp/repo",
    "commit_range": "HEAD~15..HEAD",
    "max_revisions": "3",
    "output_file": "RELEASE_NOTES.md",
    "model": "claude-haiku-4-5"
  },
  "input": {
    "test1": "test2"
  },
  "body": [
    {
      "id": "994d6284-6084-4044-8229-e1087edcbcea",
      "name": "clone-repo",
      "command": "git",
      "args": [
        "clone",
        "--depth",
        "50",
        "${config.repo_url}",
        "${config.repo_path}"
      ],
      "type": "binary"
    },
    {
      "id": "0a7ad1bc-46ad-44ef-8072-291b586e7e65",
      "name": "gather-changes",
      "publish": {
        "raw_changes": "${output}"
      },
      "command": "git",
      "args": [
        "log",
        "--stat",
        "--no-color",
        "${config.commit_range}"
      ],
      "cwd": "${config.repo_path}",
      "type": "binary"
    },
    {
      "type": "checkpoint",
      "id": "f0b9f76d-c4ba-4036-93a1-1d0fdcc98ae2",
      "name": "have-changes",
      "condition": {
        "type": "matches",
        "path": "context.raw_changes",
        "pattern": "\\S"
      }
    },
    {
      "id": "3b3b6d1c-f670-4134-80b2-1fc7fce04686",
      "name": "check-git-result",
      "publish": {
        "person-confirm": "${output}"
      },
      "description": "Do something here",
      "assignee": "Han Yang",
      "type": "person-activity"
    },
    {
      "type": "parallel",
      "id": "26353cca-4fe0-4a41-a749-f5e351c7f381",
      "name": "summarize",
      "join": "collect",
      "branches": [
        {
          "id": "a927b740-65a6-4f86-ba28-5b350e2a28d2",
          "name": "summarize-features",
          "input": {
            "raw_changes": "${context.raw_changes}"
          },
          "publish": {
            "features_summary": "${output}"
          },
          "prompt": "From the raw git history in your input, summarize the user-facing FEATURES as a markdown bullet list. Ignore fixes and chores.",
          "type": "prompt"
        },
        {
          "id": "a77f4178-1af2-45a0-832f-e94039a446ba",
          "name": "summrize-fixes",
          "input": {
            "raw_changes": "${context.raw_changes}"
          },
          "publish": {
            "fixes_summary": "${output}"
          },
          "prompt": "From the raw git history in your input, summarize BUG FIXES and internal improvements as a markdown bullet list. Ignore new features.",
          "type": "prompt"
        }
      ]
    },
    {
      "id": "ceeafd99-9873-4c66-8445-9e72c6b61e64",
      "name": "draft-notes",
      "input": {
        "features": "${context.features_summary}",
        "fixes": "${context.fixes_summary}"
      },
      "publish": {
        "draft": "${output}"
      },
      "prompt": "Write release notes in markdown from the feature and fix summaries in your input. Audience: users of the project.",
      "type": "prompt"
    },
    {
      "id": "6688a231-cb93-4fae-9075-b4e0883c7ca0",
      "name": "judge-draft",
      "input": {
        "draft": "${context.draft}",
        "raw_changes": "${context.raw_changes}"
      },
      "parse": "json",
      "publish": {
        "verdict": "${output}"
      },
      "prompt": "Judge the release-notes draft in your input. Output STRICT JSON only: { \\\"pass\\\": boolean, \\\"feedback\\\": string, \\\"suggested_format\\\": \\\"short\\\" | \\\"long\\\" }. pass=true only if accurate, complete, and readable.",
      "type": "prompt"
    },
    {
      "type": "checkpoint",
      "id": "cb582bc5-05d8-4373-9899-18a855040f0f",
      "name": "verdict-wellformed",
      "condition": {
        "type": "all",
        "of": [
          {
            "type": "exists",
            "path": "context.verdict.pass"
          },
          {
            "type": "one-of",
            "path": "context.verdict.suggested_format",
            "values": [
              "short",
              "long"
            ]
          }
        ]
      }
    },
    {
      "type": "while-do",
      "id": "84aa5de3-c645-41e7-bff0-6abb4d8d7520",
      "name": "revise-loop",
      "condition": {
        "type": "equals",
        "path": "context.verdict.pass",
        "value": false
      },
      "max_iterations": "${config.max_revisions}",
      "node": {
        "type": "workflow",
        "id": "6149a8e0-bbec-4edb-9e71-2473b9a52b53",
        "name": "revise",
        "input": {
          "draft": "${context.draft}",
          "feedback": "${context.verdict.feedback}",
          "raw_changes": "${context.raw_changes}"
        },
        "publish": {
          "draft": "${output.draft}",
          "verdict": "${output.verdict}"
        },
        "ref": "revise.workflow.json"
      }
    },
    {
      "type": "branch",
      "id": "7ab77732-5c66-4b60-8c9a-265f0a7cdf9e",
      "name": "pick-format",
      "arms": [
        {
          "when": {
            "type": "equals",
            "path": "context.verdict.suggested_format",
            "value": "short"
          },
          "node": {
            "id": "4cd63126-2f22-413c-9a32-71d2685d0348",
            "name": "format-short",
            "input": {
              "draft": "${context.draft}"
            },
            "publish": {
              "final_notes": "${output}"
            },
            "prompt": "Condense the release notes in your input to at most 10 bullets under a single heading.",
            "type": "prompt"
          }
        },
        {
          "when": {
            "type": "equals",
            "path": "context.verdict.suggested_format",
            "value": "long"
          },
          "node": {
            "id": "1e1cfbfa-52f0-4040-8bf2-8f437bc4b31a",
            "name": "format-long",
            "input": {
              "draft": "${context.draft}"
            },
            "publish": {
              "final_notes": "${output}"
            },
            "prompt": "Expand the release notes in your input into sections (Features / Fixes / Details) with a short intro paragraph.",
            "type": "prompt"
          }
        }
      ]
    },
    {
      "id": "6983cafc-8037-4275-8e0f-390aaea0a070",
      "name": "write-file",
      "input": "${context.final_notes}",
      "publish": {
        "file": "${config.output_file}"
      },
      "command": "sh",
      "args": [
        "-c",
        "cat > \"${config.output_file}\""
      ],
      "cwd": "${config.repo_path}",
      "type": "binary"
    }
  ],
  "output": {
    "file": "${context.file}"
  },
  "worker_defaults": {
    "prompt": "anthropic"
  }
}
