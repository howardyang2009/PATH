{
  "format": "path/workflow@6",
  "id": "7c7a06d0-1fe8-4941-9919-64a257cf3cd2",
  "name": "release-notes",
  "config": {
    "repo_url": "https://github.com/howardyang2009/PATH.git",
    "repo_path": "/tmp/repo",
    "commit_range": "HEAD~15..HEAD",
    "max_revisions": "3",
    "output_file": "RELEASE_NOTES.md",
    "model": "claude-haiku-4-5"
  },
  "input": {
    "test1": "test2"
  },
  "body": [
    {
      "id": "ebc05363-ea61-4ffb-9e7c-f2efff640e6d",
      "name": "clone-repo",
      "command": "git",
      "args": [
        "clone",
        "--depth",
        "50",
        "${config.repo_url}",
        "${config.repo_path}"
      ],
      "type": "binary"
    },
    {
      "id": "60eecd84-2743-4071-a0c5-7107111bad5e",
      "name": "gather-changes",
      "publish": {
        "raw_changes": "${output}"
      },
      "command": "git",
      "args": [
        "log",
        "--stat",
        "--no-color",
        "${config.commit_range}"
      ],
      "cwd": "${config.repo_path}",
      "type": "binary"
    },
    {
      "type": "checkpoint",
      "id": "84c3897f-9a2f-4b97-bb43-419b11ff71a0",
      "name": "have-changes",
      "condition": {
        "type": "matches",
        "path": "context.raw_changes",
        "pattern": "\\S"
      }
    },
    {
      "id": "602b0389-aeea-42bd-b614-5d947723a8a6",
      "name": "check-git-result",
      "publish": {
        "person-confirm": "${output}"
      },
      "description": "Do something here",
      "assignee": "Han Yang",
      "type": "person-activity"
    },
    {
      "type": "parallel",
      "id": "0ff741bc-1b5e-4404-a8cb-69528ce35822",
      "name": "summarize",
      "join": "collect",
      "branches": [
        {
          "id": "47c23e42-667d-495f-8678-84a35dd164e3",
          "name": "summarize-features",
          "input": {
            "raw_changes": "${context.raw_changes}"
          },
          "publish": {
            "features_summary": "${output}"
          },
          "prompt": "From the raw git history in your input, summarize the user-facing FEATURES as a markdown bullet list. Ignore fixes and chores.",
          "type": "prompt"
        },
        {
          "id": "21b77130-6782-49b9-9eb1-62de17e409d5",
          "name": "summrize-fixes",
          "input": {
            "raw_changes": "${context.raw_changes}"
          },
          "publish": {
            "fixes_summary": "${output}"
          },
          "prompt": "From the raw git history in your input, summarize BUG FIXES and internal improvements as a markdown bullet list. Ignore new features.",
          "type": "prompt"
        }
      ]
    },
    {
      "id": "09d7bbe9-0bee-4aa9-8a28-d7d40f85eb82",
      "name": "draft-notes",
      "input": {
        "features": "${context.features_summary}",
        "fixes": "${context.fixes_summary}"
      },
      "publish": {
        "draft": "${output}"
      },
      "prompt": "Write release notes in markdown from the feature and fix summaries in your input. Audience: users of the project.",
      "type": "prompt"
    },
    {
      "id": "2c7b781b-b085-4983-b850-a79577dee920",
      "name": "judge-draft",
      "input": {
        "draft": "${context.draft}",
        "raw_changes": "${context.raw_changes}"
      },
      "parse": "json",
      "publish": {
        "verdict": "${output}"
      },
      "prompt": "Judge the release-notes draft in your input. Output STRICT JSON only: { \\\"pass\\\": boolean, \\\"feedback\\\": string, \\\"suggested_format\\\": \\\"short\\\" | \\\"long\\\" }. pass=true only if accurate, complete, and readable.",
      "type": "prompt"
    },
    {
      "type": "checkpoint",
      "id": "5f4ffa12-5f24-4259-adaf-88536adf9be8",
      "name": "verdict-wellformed",
      "condition": {
        "type": "all",
        "of": [
          {
            "type": "exists",
            "path": "context.verdict.pass"
          },
          {
            "type": "one-of",
            "path": "context.verdict.suggested_format",
            "values": [
              "short",
              "long"
            ]
          }
        ]
      }
    },
    {
      "type": "while-do",
      "id": "0c072d21-7084-453b-b030-9dc5ed629f01",
      "name": "revise-loop",
      "condition": {
        "type": "equals",
        "path": "context.verdict.pass",
        "value": false
      },
      "max_iterations": "${config.max_revisions}",
      "node": {
        "type": "workflow",
        "id": "c9424037-57ff-49c0-bf54-a03a1f3463af",
        "name": "revise",
        "input": {
          "draft": "${context.draft}",
          "feedback": "${context.verdict.feedback}",
          "raw_changes": "${context.raw_changes}"
        },
        "publish": {
          "draft": "${output.draft}",
          "verdict": "${output.verdict}"
        },
        "ref": "revise.workflow.json"
      }
    },
    {
      "type": "branch",
      "id": "91c74382-a04f-4741-95cd-81f3e853c055",
      "name": "pick-format",
      "arms": [
        {
          "when": {
            "type": "equals",
            "path": "context.verdict.suggested_format",
            "value": "short"
          },
          "node": {
            "id": "bd2e8a79-53b2-41fd-aa13-561898e3258f",
            "name": "format-short",
            "input": {
              "draft": "${context.draft}"
            },
            "publish": {
              "final_notes": "${output}"
            },
            "prompt": "Condense the release notes in your input to at most 10 bullets under a single heading.",
            "type": "prompt"
          }
        },
        {
          "when": {
            "type": "equals",
            "path": "context.verdict.suggested_format",
            "value": "long"
          },
          "node": {
            "id": "b989e6a7-e2a7-4f68-955f-11d72da73e78",
            "name": "format-long",
            "input": {
              "draft": "${context.draft}"
            },
            "publish": {
              "final_notes": "${output}"
            },
            "prompt": "Expand the release notes in your input into sections (Features / Fixes / Details) with a short intro paragraph.",
            "type": "prompt"
          }
        }
      ]
    },
    {
      "id": "04205e1d-aa38-42aa-be43-4d7953f790ab",
      "name": "write-file",
      "input": "${context.final_notes}",
      "publish": {
        "file": "${config.output_file}"
      },
      "command": "sh",
      "args": [
        "-c",
        "mkdir -p \"${config.repo_path}\" && cat > \"${config.repo_path}/${config.output_file}\""
      ],
      "type": "binary"
    }
  ],
  "output": {
    "file": "${context.file}"
  },
  "worker_defaults": {
    "prompt": "anthropic"
  }
}
