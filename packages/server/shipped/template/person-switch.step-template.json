{
  "format": "path/workflow@6",
  "id": "79a3ebdc-20ec-4e68-9c5d-708aa9022147",
  "description": "A person picks which of several options runs next; the flow branches on the chosen label (ADR 0052).",
  "body": [
    {
      "type": "sequence",
      "id": "1fed3a20-4128-4a2e-b189-8f447a7fd275",
      "name": "person-switch",
      "body": [
        {
          "id": "cc6a8e62-d739-4e17-8a63-b0ed9d8fab3e",
          "name": "choice",
          "description": "Pick which option runs next.",
          "outputSchema": {
            "type": "object",
            "properties": {
              "choice": {
                "type": "string",
                "title": "Choice",
                "description": "The option to run next.",
                "enum": [
                  "option-a",
                  "option-b",
                  "option-c"
                ]
              }
            },
            "required": [
              "choice"
            ],
            "additionalProperties": false
          },
          "type": "person-activity"
        },
        {
          "type": "branch",
          "id": "8c13a71c-d502-40f1-98de-36b31f616f89",
          "name": "on-choice",
          "arms": [
            {
              "when": {
                "type": "equals",
                "path": "previous.choice",
                "value": "option-a"
              },
              "node": {
                "type": "goto",
                "id": "7f2087dd-66c9-451b-9cee-d5392c3069c0",
                "name": "goto-1",
                "target": "person-switch",
                "max_jumps": 3
              }
            },
            {
              "when": {
                "type": "equals",
                "path": "previous.choice",
                "value": "option-b"
              },
              "node": {
                "type": "goto",
                "id": "a97d15da-bf8d-4afc-adc9-38aa7ca38895",
                "name": "goto-2",
                "target": "person-switch",
                "max_jumps": 3
              }
            },
            {
              "when": {
                "type": "equals",
                "path": "previous.choice",
                "value": "option-c"
              },
              "node": {
                "type": "goto",
                "id": "b430b286-ee4c-4270-912a-1b7ffe534ad7",
                "name": "goto-3",
                "target": "person-switch",
                "max_jumps": 3
              }
            }
          ]
        }
      ]
    }
  ]
}
