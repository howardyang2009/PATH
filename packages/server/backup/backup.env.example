# Copy to ~/.config/path/backup.env and chmod 600. Read by backup.sh, and by
# `path-server backup verify` once exported into the shell (set -a; source it; set +a).
# PATH_SECRETS_KEY never goes here: it is not part of the backup.
PATH_PROJECT_DIR=/Users/owner/path-project
RESTIC_REPOSITORY=b2:path-backup:path
# The restic password from the login Keychain; keep an escrow copy in the password manager.
RESTIC_PASSWORD_COMMAND="security find-generic-password -s path-restic -w"
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
