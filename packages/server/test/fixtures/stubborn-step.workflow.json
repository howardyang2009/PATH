{
  "format": "path/workflow@3",
  "id": "e87d2e8b-577e-40b5-8174-d012c4854991",
  "name": "stubborn-step",
  "body": [
    {
      "type": "binary",
      "id": "389dde56-0cb1-42db-adc0-c55e64a1be26",
      "name": "linger",
      "command": "node",
      "args": [
        "-e",
        "require('fs').writeFileSync('stubborn-step.alive','');process.on('SIGTERM',()=>setTimeout(()=>process.exit(0),600));setTimeout(()=>process.stdout.write('done'),10000)"
      ],
      "publish": {
        "result": "${output}"
      }
    }
  ],
  "output": {
    "result": "${context.result}"
  }
}
