{
  "format": "path/workflow@3",
  "id": "cf159dd3-4a05-4e24-af75-b0d65210a147",
  "name": "resumable",
  "config": {
    "mode": "fail"
  },
  "body": [
    {
      "type": "binary",
      "id": "908d75e8-c8bb-4792-95e1-2d80ce2f51d7",
      "name": "step-a",
      "command": "node",
      "args": [
        "-e",
        "process.stdout.write('A')"
      ],
      "publish": {
        "fromA": "${output}"
      }
    },
    {
      "type": "binary",
      "id": "548ed098-0a65-499d-a5ea-4a1e091aca04",
      "name": "step-b",
      "command": "node",
      "args": [
        "-e",
        "if(process.argv[1]!=='ok')process.exit(3);process.stdout.write('B')",
        "${config.mode}"
      ]
    }
  ],
  "output": {
    "a": "${context.fromA}"
  }
}
