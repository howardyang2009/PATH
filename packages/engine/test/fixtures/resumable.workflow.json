{
  "format": "path/workflow@0",
  "name": "resumable",
  "worker": { "type": "engine" },
  "config": { "mode": "fail" },
  "body": [
    {
      "type": "binary",
      "id": "step-a",
      "command": "node",
      "args": ["-e", "process.stdout.write('A')"],
      "publish": { "fromA": "${output}" }
    },
    {
      "type": "binary",
      "id": "step-b",
      "command": "node",
      "args": ["-e", "if(process.argv[1]!=='ok')process.exit(3);process.stdout.write('B')", "${config.mode}"]
    }
  ],
  "output": { "a": "${context.fromA}" }
}
