{
  "format": "path/workflow@2",
  "id": "f27dd8a2-b672-468c-ade2-711350e696f0",
  "name": "context-echo",
  "worker": {
    "type": "engine"
  },
  "body": [
    {
      "type": "binary",
      "id": "41045949-9993-4a50-8f0b-1a06411b87de",
      "name": "echo",
      "command": "node",
      "args": [
        "-e",
        "process.stdout.write(process.argv[1])",
        "${context.greeting}"
      ],
      "publish": {
        "seen": "${output}"
      }
    }
  ],
  "output": {
    "seen": "${context.seen}"
  }
}
