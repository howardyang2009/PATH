{
  "name": "path-monorepo",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "sandcastle": "tsx .sandcastle/main.mts",
    "path": "tsx packages/engine/bin/path.ts",
    "serve": "pnpm --filter @path/viewer run build && pnpm --filter @path/designer run build && tsx packages/server/bin/path-server.ts . --port 8080",
    "release-notes": "pnpm path run docs/acceptance-workflow/release-notes.workflow.json"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
