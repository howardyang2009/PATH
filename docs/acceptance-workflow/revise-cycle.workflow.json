{
  "format": "path/workflow@3",
  "id": "f348a778-360b-40d2-9771-b352968d1200",
  "name": "revise-cycle",
  "config": {
    "model": "claude-sonnet-5"
  },
  "body": [
    {
      "id": "297d1380-77b8-4115-99e7-65c9afd329f5",
      "name": "revise",
      "input": {
        "draft": "${context.draft}",
        "feedback": "${context.feedback}",
        "raw_changes": "${context.raw_changes}"
      },
      "publish": {
        "draft": "${output}"
      },
      "prompt": "Revise the release-notes draft in your input according to the judge feedback, staying faithful to the raw git history. Output the full revised markdown.",
      "type": "prompt"
    },
    {
      "id": "d90ab1e0-e0dc-456f-bd3c-5a433776a2a5",
      "name": "judge",
      "input": {
        "draft": "${context.draft}"
      },
      "parse": "json",
      "publish": {
        "verdict": "${output}"
      },
      "prompt": "Judge the revised draft in your input. Output STRICT JSON only: { \"pass\": boolean, \"feedback\": string, \"suggested_format\": \"short\" | \"long\" }.",
      "type": "prompt"
    },
    {
      "type": "checkpoint",
      "id": "368c7add-20ed-400d-a9ff-015246fe4ea1",
      "name": "verdict-wellformed",
      "condition": {
        "type": "exists",
        "path": "context.verdict.pass"
      }
    }
  ],
  "output": {
    "draft": "${context.draft}",
    "verdict": "${context.verdict}"
  }
}
