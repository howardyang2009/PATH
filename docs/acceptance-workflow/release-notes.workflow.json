{
  "format": "path/workflow@0",
  "name": "release-notes",

  "worker": {
    "type": "llm",
    "model": "claude-sonnet-5"
  },

  "config": {
    "repo_path": ".",
    "commit_range": "HEAD~15..HEAD",
    "max_revisions": 3,
    "output_file": "RELEASE_NOTES.md"
  },

  "body": [
    {
      "type": "binary",
      "id": "gather-changes",
      "worker": { "type": "engine" },
      "command": "git",
      "args": ["log", "--stat", "--no-color", "${config.commit_range}"],
      "cwd": "${config.repo_path}",
      "publish": { "raw_changes": "${output}" }
    },

    {
      "type": "checkpoint",
      "id": "have-changes",
      "condition": { "type": "matches", "path": "context.raw_changes", "pattern": "\\S" }
    },

    {
      "type": "parallel",
      "id": "summarize",
      "join": "collect",
      "branches": [
        {
          "id": "features",
          "body": [
            {
              "type": "prompt",
              "id": "summarize-features",
              "input": { "raw_changes": "${context.raw_changes}" },
              "prompt": "From the raw git history in your input, summarize the user-facing FEATURES as a markdown bullet list. Ignore fixes and chores.",
              "publish": { "features_summary": "${output}" }
            }
          ]
        },
        {
          "id": "fixes",
          "body": [
            {
              "type": "prompt",
              "id": "summarize-fixes",
              "input": { "raw_changes": "${context.raw_changes}" },
              "prompt": "From the raw git history in your input, summarize BUG FIXES and internal improvements as a markdown bullet list. Ignore new features.",
              "publish": { "fixes_summary": "${output}" }
            }
          ]
        }
      ]
    },

    {
      "type": "prompt",
      "id": "draft-notes",
      "input": {
        "features": "${context.features_summary}",
        "fixes": "${context.fixes_summary}"
      },
      "prompt": "Write release notes in markdown from the feature and fix summaries in your input. Audience: users of the project.",
      "publish": { "draft": "${output}" }
    },

    {
      "type": "prompt",
      "id": "judge-draft",
      "parse": "json",
      "input": {
        "draft": "${context.draft}",
        "raw_changes": "${context.raw_changes}"
      },
      "prompt": "Judge the release-notes draft in your input. Output STRICT JSON only: { \"pass\": boolean, \"feedback\": string, \"suggested_format\": \"short\" | \"long\" }. pass=true only if accurate, complete, and readable.",
      "publish": { "verdict": "${output}" }
    },

    {
      "type": "checkpoint",
      "id": "verdict-wellformed",
      "condition": {
        "type": "all",
        "of": [
          { "type": "exists", "path": "context.verdict.pass" },
          { "type": "one-of", "path": "context.verdict.suggested_format", "values": ["short", "long"] }
        ]
      }
    },

    {
      "type": "while-do",
      "id": "revise-loop",
      "condition": { "type": "equals", "path": "context.verdict.pass", "value": false },
      "max_iterations": "${config.max_revisions}",
      "body": [
        {
          "type": "workflow",
          "id": "revise",
          "ref": "./revise-cycle.workflow.json",
          "input": {
            "draft": "${context.draft}",
            "feedback": "${context.verdict.feedback}",
            "raw_changes": "${context.raw_changes}"
          },
          "publish": {
            "draft": "${output.draft}",
            "verdict": "${output.verdict}"
          }
        }
      ]
    },

    {
      "type": "branch",
      "id": "pick-format",
      "arms": [
        {
          "when": { "type": "equals", "path": "context.verdict.suggested_format", "value": "short" },
          "body": [
            {
              "type": "prompt",
              "id": "format-short",
              "input": { "draft": "${context.draft}" },
              "prompt": "Condense the release notes in your input to at most 10 bullets under a single heading.",
              "publish": { "final_notes": "${output}" }
            }
          ]
        },
        {
          "when": { "type": "equals", "path": "context.verdict.suggested_format", "value": "long" },
          "body": [
            {
              "type": "prompt",
              "id": "format-long",
              "input": { "draft": "${context.draft}" },
              "prompt": "Expand the release notes in your input into sections (Features / Fixes / Details) with a short intro paragraph.",
              "publish": { "final_notes": "${output}" }
            }
          ]
        }
      ]
    },

    {
      "type": "binary",
      "id": "write-file",
      "worker": { "type": "engine" },
      "input": "${context.final_notes}",
      "command": "sh",
      "args": ["-c", "cat > \"${config.output_file}\""],
      "cwd": "${config.repo_path}",
      "publish": { "file": "${config.output_file}" }
    }
  ],

  "output": { "file": "${context.file}" }
}
