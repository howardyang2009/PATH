{
  "format": "path/workflow@3",
  "id": "0141fbab-90a7-4f63-b030-91b89c0cb508",
  "name": "release-notes",
  "config": {
    "repo_path": ".",
    "commit_range": "HEAD~15..HEAD",
    "max_revisions": 3,
    "output_file": "RELEASE_NOTES.md",
    "model": "claude-sonnet-5"
  },
  "body": [
    {
      "id": "772e1536-ccd9-4aad-bbdb-a654768cd0a4",
      "name": "gather-changes",
      "publish": {
        "raw_changes": "${output}"
      },
      "command": "git",
      "args": [
        "log",
        "--stat",
        "--no-color",
        "${config.commit_range}"
      ],
      "cwd": "${config.repo_path}",
      "type": "binary"
    },
    {
      "type": "checkpoint",
      "id": "24e3e333-9ded-4399-80c9-f253ed20df06",
      "name": "have-changes",
      "condition": {
        "type": "matches",
        "path": "context.raw_changes",
        "pattern": "\\S"
      }
    },
    {
      "type": "parallel",
      "id": "ae639fab-2029-4b7f-bfbd-6f4dcbe8712f",
      "name": "summarize",
      "join": "collect",
      "branches": [
        {
          "id": "ba536aae-a5b9-4c38-9f32-28a210829bc2",
          "name": "summarize-features",
          "input": {
            "raw_changes": "${context.raw_changes}"
          },
          "publish": {
            "features_summary": "${output}"
          },
          "prompt": "From the raw git history in your input, summarize the user-facing FEATURES as a markdown bullet list. Ignore fixes and chores.",
          "type": "prompt"
        },
        {
          "id": "f8dafcf5-e9ec-481c-822b-40e3b3770a1c",
          "name": "summarize-fixes",
          "input": {
            "raw_changes": "${context.raw_changes}"
          },
          "publish": {
            "fixes_summary": "${output}"
          },
          "prompt": "From the raw git history in your input, summarize BUG FIXES and internal improvements as a markdown bullet list. Ignore new features.",
          "type": "prompt"
        }
      ]
    },
    {
      "id": "daa17f91-c040-4dae-9279-1b94a1bb28c5",
      "name": "draft-notes",
      "input": {
        "features": "${context.features_summary}",
        "fixes": "${context.fixes_summary}"
      },
      "publish": {
        "draft": "${output}"
      },
      "prompt": "Write release notes in markdown from the feature and fix summaries in your input. Audience: users of the project.",
      "type": "prompt"
    },
    {
      "id": "53cb3fd1-ee99-4738-8c6c-5ae77e736f67",
      "name": "judge-draft",
      "input": {
        "draft": "${context.draft}",
        "raw_changes": "${context.raw_changes}"
      },
      "parse": "json",
      "publish": {
        "verdict": "${output}"
      },
      "prompt": "Judge the release-notes draft in your input. Output STRICT JSON only: { \"pass\": boolean, \"feedback\": string, \"suggested_format\": \"short\" | \"long\" }. pass=true only if accurate, complete, and readable.",
      "type": "prompt"
    },
    {
      "type": "checkpoint",
      "id": "10c51ce4-12ad-437a-8344-f3765fd00752",
      "name": "verdict-wellformed",
      "condition": {
        "type": "all",
        "of": [
          {
            "type": "exists",
            "path": "context.verdict.pass"
          },
          {
            "type": "one-of",
            "path": "context.verdict.suggested_format",
            "values": [
              "short",
              "long"
            ]
          }
        ]
      }
    },
    {
      "type": "while-do",
      "id": "cce85a65-8d02-43ab-8341-5aac180c287a",
      "name": "revise-loop",
      "condition": {
        "type": "equals",
        "path": "context.verdict.pass",
        "value": false
      },
      "max_iterations": "${config.max_revisions}",
      "node": {
        "type": "workflow",
        "id": "c24eda53-4975-47ac-a446-13bad94027c6",
        "name": "revise",
        "input": {
          "draft": "${context.draft}",
          "feedback": "${context.verdict.feedback}",
          "raw_changes": "${context.raw_changes}"
        },
        "publish": {
          "draft": "${output.draft}",
          "verdict": "${output.verdict}"
        },
        "ref": "./revise-cycle.workflow.json"
      }
    },
    {
      "type": "branch",
      "id": "03001295-35be-41a0-8f20-8f73382e36e6",
      "name": "pick-format",
      "arms": [
        {
          "when": {
            "type": "equals",
            "path": "context.verdict.suggested_format",
            "value": "short"
          },
          "node": {
            "id": "a31156c9-9dd1-4a74-843b-fdc35914c6a6",
            "name": "format-short",
            "input": {
              "draft": "${context.draft}"
            },
            "publish": {
              "final_notes": "${output}"
            },
            "prompt": "Condense the release notes in your input to at most 10 bullets under a single heading.",
            "type": "prompt"
          }
        },
        {
          "when": {
            "type": "equals",
            "path": "context.verdict.suggested_format",
            "value": "long"
          },
          "node": {
            "id": "ffa663b8-8e1e-46f8-b2b5-cce82bc2ed7e",
            "name": "format-long",
            "input": {
              "draft": "${context.draft}"
            },
            "publish": {
              "final_notes": "${output}"
            },
            "prompt": "Expand the release notes in your input into sections (Features / Fixes / Details) with a short intro paragraph.",
            "type": "prompt"
          }
        }
      ]
    },
    {
      "id": "0b65a81d-823f-4db3-b002-9e75cb0ca35d",
      "name": "write-file",
      "input": "${context.final_notes}",
      "publish": {
        "file": "${config.output_file}"
      },
      "command": "sh",
      "args": [
        "-c",
        "cat > \"${config.output_file}\""
      ],
      "cwd": "${config.repo_path}",
      "type": "binary"
    }
  ],
  "output": {
    "file": "${context.file}"
  }
}
