{
  "format": "path/workflow@2",
  "id": "6699bc46-e0a3-48c9-bd39-ea74bf3491a0",
  "name": "do-not-wait-probe",
  "worker": {
    "type": "engine"
  },
  "config": {
    "signal_file": "signal.log",
    "branch_delay_ms": "0",
    "branch_exit_code": "0"
  },
  "body": [
    {
      "type": "parallel",
      "id": "bba99b63-3cfb-428c-bd8c-07c5273a09bb",
      "name": "fire",
      "join": "do-not-wait",
      "branches": [
        {
          "type": "binary",
          "id": "349f1aab-027a-4519-ab16-f0a8e3a78419",
          "name": "post-signal",
          "command": "node",
          "args": [
            "-e",
            "const [file, delay, code] = process.argv.slice(1); require('node:fs').appendFileSync(file, 'fired\\n'); setTimeout(() => { process.exitCode = Number(code); }, Number(delay));",
            "${config.signal_file}",
            "${config.branch_delay_ms}",
            "${config.branch_exit_code}"
          ]
        }
      ]
    },
    {
      "type": "binary",
      "id": "f582e529-bfc2-406d-8f06-d6ab922260d8",
      "name": "after",
      "command": "node",
      "args": [
        "-e",
        "let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>process.stdout.write(d));"
      ],
      "publish": {
        "seen": "${output}"
      }
    }
  ],
  "output": {
    "seen": "${context.seen}"
  }
}
