{
  "format": "path/workflow@3",
  "id": "0999a31b-fe1a-4929-aa05-e4deae1ffb1d",
  "name": "env-secret-probe",
  "config": {
    "token": {
      "$secret": {
        "$env": "PATH_ACCEPTANCE_TOKEN"
      }
    },
    "probe_id": {
      "$env": "PATH_ACCEPTANCE_PROBE_ID"
    },
    "receipt_file": "token-receipt.txt",
    "exit_code": "0"
  },
  "body": [
    {
      "type": "binary",
      "id": "3709bb5e-5b3b-44dc-ab40-3979625bb4d8",
      "name": "use-token",
      "command": "node",
      "args": [
        "-e",
        "const [token, probeId, receiptFile, exitCode] = process.argv.slice(1); require('node:fs').writeFileSync(receiptFile, token); process.stderr.write('probe ' + probeId + ': bearer ' + token + ' rejected\\n'); process.stdout.write(token); process.exitCode = Number(exitCode);",
        "${config.token}",
        "${config.probe_id}",
        "${config.receipt_file}",
        "${config.exit_code}"
      ],
      "input": {
        "token": "${config.token}",
        "probe_id": "${config.probe_id}"
      },
      "publish": {
        "echoed": "${output}"
      }
    },
    {
      "type": "checkpoint",
      "id": "c6174a6a-fbbd-4b34-913e-4ab6fe8ea618",
      "name": "token-round-tripped",
      "condition": {
        "type": "matches",
        "path": "context.echoed",
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    }
  ],
  "output": {
    "probe_id": "${config.probe_id}"
  }
}
