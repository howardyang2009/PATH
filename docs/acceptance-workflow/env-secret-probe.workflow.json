{
  "format": "path/workflow@0",
  "name": "env-secret-probe",

  "worker": { "type": "engine" },

  "config": {
    "token": { "$secret": { "$env": "PATH_ACCEPTANCE_TOKEN" } },
    "probe_id": { "$env": "PATH_ACCEPTANCE_PROBE_ID" },
    "receipt_file": "token-receipt.txt",
    "exit_code": "0"
  },

  "body": [
    {
      "type": "binary",
      "id": "use-token",
      "command": "node",
      "args": [
        "-e",
        "const [token, probeId, receiptFile, exitCode] = process.argv.slice(1); require('node:fs').writeFileSync(receiptFile, token); process.stderr.write('probe ' + probeId + ': bearer ' + token + ' rejected\\n'); process.stdout.write(token); process.exitCode = Number(exitCode);",
        "${config.token}",
        "${config.probe_id}",
        "${config.receipt_file}",
        "${config.exit_code}"
      ],
      "input": { "token": "${config.token}", "probe_id": "${config.probe_id}" },
      "publish": { "echoed": "${output}" }
    },

    {
      "type": "checkpoint",
      "id": "token-round-tripped",
      "condition": { "type": "matches", "path": "context.echoed", "pattern": "^[A-Za-z0-9._-]+$" }
    }
  ],

  "output": { "probe_id": "${config.probe_id}" }
}
